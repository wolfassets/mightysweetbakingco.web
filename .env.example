# web-c runtime config. Copy to .env for local dev; set these in Vercel's
# Environment Variables for production.

PORT=4002

# Oracle runs the API on each web node. The systemd override keeps this hop
# local so Caddy does not discard the visitor IP forwarded by web-c.
API_BASE=http://localhost:3000

# Apple MapKit JS token (dev token; rotate for prod). Used to render the /map page.
MAPKIT_TOKEN=
